// Auth API service for login, registration, logout, and current-user lookup using fetch.

import { authConfig } from '../config/authConfig';
import { decodeToken, getToken, removeToken, setToken, type TokenPayload } from '../utils/tokenUtils';

export interface User extends TokenPayload {
  id?: string;
}

export interface AuthResponse {
  token: string;
  user: User | null;
}

const authEndpoint = `${authConfig.apiBaseUrl}/auth`;

const parseResponse = async <T>(response: Response, fallbackMessage: string): Promise<T> => {
  const contentType = response.headers.get('content-type') || '';
  const data = contentType.includes('application/json') ? await response.json() : null;

  if (!response.ok) {
    throw new Error(data?.message || fallbackMessage);
  }

  return data as T;
};

const getAuthHeaders = (): Record<string, string> => {
  const token = getToken();

  return token ? { Authorization: `Bearer ${token}` } : {};
};

export const login = async (email: string, password: string): Promise<AuthResponse> => {
  try {
    const response = await fetch(`${authEndpoint}${authConfig.loginPath}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password }),
    });
    const data = await parseResponse<AuthResponse>(response, 'Unable to log in.');

    if (!data?.token) {
      throw new Error('Login response did not include a JWT token.');
    }

    setToken(data.token);

    return {
      token: data.token,
      user: data.user || decodeToken(data.token),
    };
  } catch (error) {
    throw new Error(error instanceof Error ? error.message : 'Unable to log in.');
  }
};

export const register = async (email: string, password: string, name: string): Promise<unknown> => {
  try {
    const response = await fetch(`${authEndpoint}${authConfig.registerPath}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email, password, name }),
    });

    return await parseResponse<unknown>(response, 'Unable to register.');
  } catch (error) {
    throw new Error(error instanceof Error ? error.message : 'Unable to register.');
  }
};

export const logout = (): void => {
  removeToken();
};

export const getCurrentUser = async (): Promise<User> => {
  try {
    const response = await fetch(`${authEndpoint}${authConfig.mePath}`, {
      headers: getAuthHeaders(),
    });
    const data = await parseResponse<{ user?: User } | User>(response, 'Unable to fetch the current user.');

    const currentUser = data as ({ user?: User } & User);
    return currentUser.user || currentUser;
  } catch (error) {
    throw new Error(error instanceof Error ? error.message : 'Unable to fetch the current user.');
  }
};
