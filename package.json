{
  "name": "react-base-pack",
  "version": "1.0.0",
  "description": "CLI foundation for injecting scalable React project architecture into existing apps.",
  "type": "module",
  "bin": {
    "react-base-pack": "./bin/index.js"
  },
  "scripts": {
    "start": "node bin/index.js",
    "lint": "eslint src/**/*.js bin/**/*.js test/**/*.js",
    "test": "node --test",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run lint && npm test && npm run pack:dry-run"
  },
  "keywords": [
    "react",
    "cli",
    "architecture",
    "scaffold",
    "boilerplate"
  ],
  "author": "Anshuman Bharatiya",
  "license": "MIT",
  "homepage": "https://www.npmjs.com/package/react-base-pack",
  "bugs": {
    "url": "https://github.com/anshuman-bharatiya/react-base-pack/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anshuman-bharatiya/react-base-pack.git"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "TESTING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.23",
    "ora": "^6.3.1"
  },
  "devDependencies": {
    "eslint": "^9.3.0"
  }
}
