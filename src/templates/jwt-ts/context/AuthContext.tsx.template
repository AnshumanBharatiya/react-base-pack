// React context provider for JWT auth state and actions.

import { createContext, useCallback, useContext, useEffect, useMemo, useState, type ReactNode } from 'react';
import * as authService from '../services/authService';
import { decodeToken, getToken, isTokenExpired, removeToken } from '../utils/tokenUtils';
import type { AuthResponse, User } from '../services/authService';

export interface AuthContextType {
  user: User | null;
  token: string | null;
  isAuthenticated: boolean;
  login: (email: string, password: string) => Promise<AuthResponse>;
  logout: () => void;
  loading: boolean;
  authLoading: boolean;
}

interface AuthProviderProps {
  children: ReactNode;
}

export const AuthContext = createContext<AuthContextType | null>(null);

export const AuthProvider = ({ children }: AuthProviderProps) => {
  const [user, setUser] = useState<User | null>(null);
  const [token, setTokenState] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);
  const [authLoading, setAuthLoading] = useState(false);

  const logout = useCallback(() => {
    authService.logout();
    removeToken();
    setTokenState(null);
    setUser(null);
  }, []);

  useEffect(() => {
    const hydrateAuth = async () => {
      const storedToken = getToken();

      if (!storedToken || isTokenExpired(storedToken)) {
        logout();
        setLoading(false);
        return;
      }

      setTokenState(storedToken);

      try {
        const currentUser = await authService.getCurrentUser();
        setUser(currentUser);
      } catch {
        const tokenUser = decodeToken(storedToken);

        if (tokenUser) {
          setUser(tokenUser);
        } else {
          logout();
        }
      } finally {
        setLoading(false);
      }
    };

    hydrateAuth();
  }, [logout]);

  const login = useCallback(async (email: string, password: string) => {
    setAuthLoading(true);

    try {
      const authResult = await authService.login(email, password);
      setTokenState(authResult.token);
      setUser(authResult.user);

      return authResult;
    } finally {
      setAuthLoading(false);
    }
  }, []);

  const value = useMemo<AuthContextType>(() => {
    return {
      user,
      token,
      isAuthenticated: Boolean(token && user),
      login,
      logout,
      loading,
      authLoading,
    };
  }, [authLoading, loading, login, logout, token, user]);

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
};

export const useAuthContext = (): AuthContextType => {
  const context = useContext(AuthContext);

  if (!context) {
    throw new Error('useAuthContext must be used within an AuthProvider.');
  }

  return context;
};
