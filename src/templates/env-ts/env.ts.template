// Centralized environment config for React apps.

type RuntimeEnv = Record<string, string | undefined>;

const metaEnv = import.meta.env as RuntimeEnv;
const runtimeEnv = 'process' in globalThis
  ? (globalThis as { process?: { env?: RuntimeEnv } }).process?.env || {}
  : {};

const appEnv = metaEnv.VITE_APP_ENV || runtimeEnv.REACT_APP_ENV || runtimeEnv.NEXT_PUBLIC_APP_ENV || 'development';

export const env = {
  apiUrl: metaEnv.VITE_API_URL || runtimeEnv.REACT_APP_API_URL || runtimeEnv.NEXT_PUBLIC_API_URL || '',
  appEnv,
  isDevelopment: appEnv === 'development',
  isProduction: appEnv === 'production'
};

export default env;
