// JWT token storage and decoding helpers with Base64URL-safe parsing.

import { authConfig } from '../config/authConfig';

export interface TokenPayload {
  exp?: number;
  sub?: string;
  email?: string;
  name?: string;
  [key: string]: unknown;
}

const canUseStorage = () => typeof window !== 'undefined' && Boolean(window.localStorage);

const decodeBase64Url = (value: string): string => {
  const base64 = value.replace(/-/g, '+').replace(/_/g, '/');
  const padded = base64.padEnd(base64.length + ((4 - (base64.length % 4)) % 4), '=');

  if (typeof atob === 'function') {
    return atob(padded);
  }

  throw new Error('No Base64 decoder is available in this environment.');
};

export const getToken = (): string | null => {
  if (!canUseStorage()) {
    return null;
  }

  return window.localStorage.getItem(authConfig.tokenKey);
};

export const setToken = (token: string): void => {
  if (canUseStorage()) {
    window.localStorage.setItem(authConfig.tokenKey, token);
  }
};

export const removeToken = (): void => {
  if (canUseStorage()) {
    window.localStorage.removeItem(authConfig.tokenKey);
  }
};

export const decodeToken = (token: string | null): TokenPayload | null => {
  try {
    if (!token || token.split('.').length < 2) {
      return null;
    }

    const payload = token.split('.')[1];
    return JSON.parse(decodeBase64Url(payload)) as TokenPayload;
  } catch {
    return null;
  }
};

export const isTokenExpired = (token: string | null): boolean => {
  const decodedToken = decodeToken(token);

  if (!decodedToken?.exp) {
    return true;
  }

  return decodedToken.exp * 1000 <= Date.now();
};
