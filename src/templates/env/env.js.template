// Centralized environment config for React apps.

const metaEnv = import.meta.env || {};
const runtimeEnv = globalThis.process?.env || {};

export const env = {
  apiUrl: metaEnv.VITE_API_URL || runtimeEnv.REACT_APP_API_URL || runtimeEnv.NEXT_PUBLIC_API_URL || '',
  appEnv: metaEnv.VITE_APP_ENV || runtimeEnv.REACT_APP_ENV || runtimeEnv.NEXT_PUBLIC_APP_ENV || 'development',
  isDevelopment: (metaEnv.VITE_APP_ENV || runtimeEnv.REACT_APP_ENV || runtimeEnv.NEXT_PUBLIC_APP_ENV) === 'development',
  isProduction: (metaEnv.VITE_APP_ENV || runtimeEnv.REACT_APP_ENV || runtimeEnv.NEXT_PUBLIC_APP_ENV) === 'production'
};

export default env;
